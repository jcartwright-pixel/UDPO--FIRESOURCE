{
  "name": "UD Garage Station",
  "short_name": "Garage Station",
  "description": "Garage Station tablets: work orders, start, stop and complete. Opens full screen; Release (manager code) is the only way out.",
  "id": "/garage-station.html",
  "start_url": "/garage-station.html",
  "scope": "/",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#0e138d",
  "theme_color": "#074c84",
  "icons": [
    {
      "src": "/img/app-icon/garage-station/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/img/app-icon/garage-station/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/img/app-icon/garage-station/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/img/app-icon/garage-station/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
