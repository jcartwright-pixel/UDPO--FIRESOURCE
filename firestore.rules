rules_version = '2';
// United Dairy Distribution app. Screens may only READ, and only when signed in with a verified
// @uniteddairy.com Google account that is ACTIVE in USERS_MASTER (the same list the current app uses).
// Every write goes through the server (functions/index.js), never the browser.
service cloud.firestore {
  match /databases/{database}/documents {
    function unitedDairy() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@uniteddairy[.]com$');
    }
    // A United Dairy account is not enough to see dispatch data or driver phone numbers: the person must be an
    // ACTIVE user in USERS_MASTER (copied to users/{email}). One extra read per query, not per document.
    function activeUser() {
      return unitedDairy()
        && get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.get('status', '') == 'ACTIVE';
    }
    // A Plant Station signed in by its code alone (Joe 10/12; index.js stationSignIn): only while its plant's switch is On and
    // its station still has the same code (stationAccess, which the server keeps in step), and only the plant-floor screens'
    // lists below. Never a person's entry, dispatch weeks or any other list.
    function plantStation() {
      return request.auth != null && request.auth.token.get('udStation', '') != ''
        && get(/databases/$(database)/documents/stationAccess/$(request.auth.token.get('udPlant', 'none'))).data.get('on', false) == true
        && get(/databases/$(database)/documents/stationAccess/$(request.auth.token.get('udPlant', 'none'))).data.get('keys', {}).get(request.auth.token.udStation, '') == request.auth.token.get('udVersion', 'none');
    }
    function activeUserOrStation() { return activeUser() || plantStation(); }
    match /config/app { allow read: if activeUserOrStation(); }
    match /config/fleetSync { allow read: if activeUser(); }
    match /config/fleetSyncPreview { allow read: if activeUser(); }
    match /config/mocreo { allow read: if activeUser(); }
    // Fleet Service's service rules (Fleet Service Setup; the server writes them).
    match /config/fleetRules { allow read: if activeUser(); }
    // MOCREO cooler sensors (server only writes them).
    match /sensors/{id} { allow read: if activeUser(); }
    // Thermometer locations changed in Administration > MOCREO & Sensors (the server writes them; the key stays in private/).
    match /tempLocations/{id} { allow read: if activeUser(); }
    match /weeks/{id} { allow read: if activeUser(); }
    match /runs/{id} { allow read: if activeUserOrStation(); }
    match /drivers/{id} { allow read: if activeUser(); }
    match /equipment/{id} { allow read: if activeUserOrStation(); }
    match /routes/{id} { allow read: if activeUser(); }
    // Each person may read their own entry (to know which buttons to show, or that they are not on the list), not everyone's.
    match /users/{email} { allow read: if unitedDairy() && request.auth.token.email.lower() == email; }
    match /transfers/{id} { allow read: if activeUser(); }
    match /exceptions/{id} { allow read: if activeUser(); }
    match /vacations/{id} { allow read: if activeUser(); }
    match /plantLoads/{id} { allow read: if activeUser(); }
    match /maintenance/{id} { allow read: if activeUserOrStation(); }
    match /mailCopies/{id} { allow read: if activeUser(); }
    match /workOrders/{id} { allow read: if activeUser(); }
    match /fleetSetup/{id} { allow read: if activeUser(); }
    match /garageTechs/{id} { allow read: if activeUser(); }
    match /odometers/{id} { allow read: if activeUser(); }
    match /otrRoutes/{id} { allow read: if activeUser(); }
    match /otrDaily/{id} { allow read: if activeUser(); }
    match /otrMonthly/{id} { allow read: if activeUser(); }
    match /otrMonthRuns/{id} { allow read: if activeUser(); }
    match /otrComments/{id} { allow read: if activeUser(); }
    match /plantEvents/{id} { allow read: if activeUser(); }
    // The drivers' DVIR inspections (phone.js), one per trailer.
    match /dvirs/{id} { allow read: if activeUser(); }
    match /scorecard/{id} { allow read: if activeUser(); }
    match /opsAssignments/{id} { allow read: if activeUser(); }
    // The plant side: the plant journal, pickups, and the wash and returns lists.
    match /plantJournal/{id} { allow read: if activeUserOrStation(); }
    match /pickups/{id} { allow read: if activeUserOrStation(); }
    match /plantWash/{id} { allow read: if activeUserOrStation(); }
    match /plantReturns/{id} { allow read: if activeUser(); }
    // The production lines, temperature locations and the lines' last checks.
    match /plantSetup/{id} { allow read: if activeUser(); }
    match /plantProducts/{id} { allow read: if activeUserOrStation(); }
    // Receiving scan-in: each scan on a delivery, and what the plant receives (saved only through save).
    match /receivingScans/{id} { allow read: if activeUserOrStation(); }
    match /receivingItems/{id} { allow read: if activeUserOrStation(); }
    // Each plant's own product areas and groups (Administration > Products).
    match /productSetup/{id} { allow read: if activeUserOrStation(); }
    match /plantShifts/{id} { allow read: if activeUser(); }
    // Plant Production: each line's shift on the tablet, and how each line is counted (saved only through save).
    match /productionRuns/{id} { allow read: if activeUser(); }
    match /productionLines/{id} { allow read: if activeUser(); }
    match /plantLineStatus/{id} { allow read: if activeUser(); }
    // Safety Walkthrough: the weekly walks, their open issues and photos, each plant's extinguishers and checklist (saved only through save).
    match /safetyWalks/{id} { allow read: if activeUser(); }
    match /safetyIssues/{id} { allow read: if activeUser(); }
    match /safetyPhotos/{id} { allow read: if activeUser(); }
    match /extinguishers/{id} { allow read: if activeUser(); }
    match /fireSystems/{id} { allow read: if activeUser(); }
    match /safetySetup/{id} { allow read: if activeUser(); }
    match /locationAreas/{id} { allow read: if activeUser(); }
    // Plant Maintenance: machinery, work orders and PM tasks (saved only through the server).
    match /plantMachines/{id} { allow read: if activeUser(); }
    match /plantWorkOrders/{id} { allow read: if activeUser(); }
    match /plantPmTasks/{id} { allow read: if activeUser(); }
    // Plant reports sent from the Manager Center, and whether each was emailed.
    match /plantReports/{id} { allow read: if activeUser(); }
    // Sheet cells the write-back did not write, so a dispatcher can check them.
    match /conflicts/{id} { allow read: if activeUser(); }
    match /{other=**} { allow read, write: if false; }
  }
}
